# =============================================================================
# Prior Authorization Evidence Assistant - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_DB=pa_assistant
POSTGRES_USER=pa_app
POSTGRES_PASSWORD=changeme_use_secrets_manager

# Full async URL for SQLAlchemy (uses asyncpg driver)
DATABASE_URL=postgresql+asyncpg://pa_app:changeme_use_secrets_manager@localhost:5432/pa_assistant

# --- MinIO ---
MINIO_ROOT_USER=pa_app
MINIO_ROOT_PASSWORD=changeme_use_secrets_manager
# Internal endpoint seen by the backend (running on host)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=pa_app
MINIO_SECRET_KEY=changeme_use_secrets_manager

# --- Qdrant ---
QDRANT_URL=http://localhost:6333

# --- Text-Embeddings-Inference (TEI) ---
TEI_URL=http://localhost:8080

# --- Ollama (native on host) ---
OLLAMA_URL=http://localhost:11434

# --- JWT / Auth ---
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=changeme_generate_a_real_secret_before_use
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- GPU / Hardware ---
GPU_PRIORITY_POLICY=llm_first
OCR_CPU_FALLBACK_TIMEOUT_SECONDS=10
VRAM_BUDGET_MB=6144

# --- Application Tuning ---
TURN_BUDGET=10
SLA_DEADLINE_HOURS=24
LOCK_EXPIRY_HOURS=2
